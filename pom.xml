<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>
	<groupId>ai.philterd</groupId>
	<artifactId>policy-editor</artifactId>
	<version>1.1.0</version>
	<name>policy-editor</name>
 <description>Philterd Redaction Policy Editor</description>
	<properties>
		<java.version>25</java.version>
		<phileas.version>4.2.0</phileas.version>
		<phisql.version>1.2.0</phisql.version>
		<!-- The JavaScript tests need Node. They are skipped whenever tests are skipped
		     (-DskipTests, as the Docker build does), and can be skipped on their own with
		     -DskipJsTests. Surefire's own skip flags do not reach a plugin bound to the test
		     phase, so this has to be wired up explicitly. -->
		<skipTests>false</skipTests>
		<skipJsTests>${skipTests}</skipJsTests>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>ai.philterd</groupId>
			<artifactId>phileas</artifactId>
			<version>${phileas.version}</version>
		</dependency>
		<dependency>
			<!-- PhiSQL reference compiler: compiles PhiSQL policy source to native Phileas policy JSON. -->
			<groupId>ai.philterd</groupId>
			<artifactId>phisql</artifactId>
			<version>${phisql.version}</version>
		</dependency>
		<dependency>
			<!-- Serves /actuator/health and /actuator/prometheus. Exposure is limited in
			     application.properties; see the README. -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.18.0</version>
		</dependency>
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>1.5.4</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<finalName>philterd-policy-editor</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- The highlight rendering in policy-form.js is JavaScript, so its tests run under
				     Node during the test phase. See skipJsTests above for skipping them. -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>javascript-tests</id>
						<phase>test</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${skipJsTests}</skip>
							<executable>node</executable>
							<arguments>
								<argument>${project.basedir}/src/test/js/highlight.test.js</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<version>9.0.1</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>initialize</phase>
					</execution>
				</executions>
				<configuration>
					<failOnNoGitDirectory>false</failOnNoGitDirectory>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
					<includeOnlyProperties>
						<includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
					</includeOnlyProperties>
					<commitIdGenerationMode>full</commitIdGenerationMode>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
